{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 440,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "padding": {"top": 15},
  "title": {
    "text": "Biodiversity Breadth: Distinct Threatened Species Tracked",
    "subtitle": [
      "Circle size encodes distinct threatened species",
      "actively monitored in each state or territory."
    ],
    "subtitleLimit": 580,
    "limit": 580,
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 11.5,
    "subtitleColor": "#475569",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "params": [
    {
      "name": "highlight_state",
      "value": null
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0, 0],
    "parallels": [-18, -36],
    "center": [0, -26.0],
    "scale": 580,
    "translate": [240, 220]
  },
  "layer": [
    {
      "description": "Layer 1: Base Map Outline",
      "data": {
        "url": "data/ne_10m_admin_1_states_provinces.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "cursor": "pointer"
      }
    },
    {
      "description": "Layer 2: Proportional Circle Symbols for State Centroids",
      "data": {
        "url": "data/m2_state_symbols.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#475569",
        "fillOpacity": 0.82,
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "taxa_count",
          "type": "quantitative",
          "title": "Species Monitored",
          "scale": {
            "type": "linear",
            "domain": [0, 70],
            "range": [120, 2600],
            "zero": true
          },
          "legend": {
            "orient": "none",
            "legendX": 435,
            "legendY": 20,
            "titleFontSize": 12,
            "labelFontSize": 10.5,
            "values": [15, 29, 44, 59, 65],
            "labelExpr": "datum.value == 15 ? '1-15' : datum.value == 29 ? '16-29' : datum.value == 44 ? '30-44' : datum.value == 59 ? '45-59' : '60 and above'",
            "offset": 8
          }
        },
        "opacity": {
          "condition": {
            "test": "highlight_state == null || datum.State == highlight_state",
            "value": 0.8
          },
          "value": 0.12
        },
        "strokeWidth": {
          "condition": {
            "test": "highlight_state != null && datum.State == highlight_state",
            "value": 2.5
          },
          "value": 1.5
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "taxa_count",
            "type": "quantitative",
            "title": "Species Monitored",
            "format": ","
          },
          {
            "field": "time_series_count",
            "type": "quantitative",
            "title": "Survey Datasets",
            "format": ","
          }
        ]
      }
    },
    {
      "description": "Leader lines to ocean annotations",
      "data": {
        "values": [
          { "lon1": 132.5, "lat1": -15.5, "lon2": 126.5, "lat2": -12.2 },
          { "lon1": 147.2, "lat1": -33.0, "lon2": 151.0, "lat2": -33.0 }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#475569",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon1",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat1",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "description": "Annotation: Ocean label for Northern Territory",
      "data": {
        "values": [
          {
            "lon": 118.0,
            "lat": -9.8,
            "text": "Northern Territory: 29 species tracked"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1e293b",
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "description": "Annotation: Ocean label for New South Wales",
      "data": {
        "values": [
          {
            "lon": 151.5,
            "lat": -33.0,
            "text": "New South Wales: 62 species tracked"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1e293b",
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": null
    }
  }
}
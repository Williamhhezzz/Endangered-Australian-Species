{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "title": {
    "text": "State-by-State Population Level Shift (2000 Baseline vs 2022)",
    "subtitle": "Comparison of relative abundance index across Australian states. Source: TSX 2025.",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "data": {
    "url": "data/c9_state_trends.csv"
  },
  "transform": [
    {
      "calculate": "datum.Percent_Change + '%'",
      "as": "change_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Index_2022",
        "order": "ascending"
      },
      "axis": {
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "description": "Connecting Rule Segment between 2000 Baseline and 2022 Level",
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#cbd5e1"
      },
      "encoding": {
        "x": {
          "field": "Baseline_2000",
          "type": "quantitative",
          "title": "Threatened Species Index Level (2000 = 100%)",
          "scale": {
            "domain": [0, 110]
          }
        },
        "x2": {
          "field": "Index_2022"
        }
      }
    },
    {
      "description": "2000 Baseline Point at 100%",
      "mark": {
        "type": "circle",
        "size": 100,
        "color": "#64748b"
      },
      "encoding": {
        "x": {
          "field": "Baseline_2000",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "value": "100%",
            "title": "2000 Baseline Level"
          }
        ]
      }
    },
    {
      "description": "2022 Current Level Point",
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#991b1b"
      },
      "encoding": {
        "x": {
          "field": "Index_2022",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "Index_2022",
            "type": "quantitative",
            "title": "2022 Level (%)",
            "format": ".1f"
          },
          {
            "field": "change_label",
            "type": "nominal",
            "title": "Change Since 2000"
          }
        ]
      }
    },
    {
      "description": "Direct Numeric Percentage Change Label",
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#991b1b"
      },
      "encoding": {
        "x": {
          "field": "Index_2022",
          "type": "quantitative"
        },
        "text": {
          "field": "change_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "title": {
    "text": "National Fauna Abundance Collapse & Cumulative Statutory Listings",
    "subtitle": "Trajectory of monitored vertebrate abundance indexed against cumulative statutory listings.",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/c1_indexline_streamgraph.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "value": "number",
        "Birds": "number",
        "Mammals": "number",
        "Reptiles": "number",
        "Amphibians": "number"
      }
    }
  },
  "vconcat": [
    {
      "title": {
        "text": "A. National Abundance Trajectory (Baseline = 1.0)",
        "fontSize": 15,
        "fontWeight": "bold",
        "anchor": "start",
        "frame": "bounds"
      },
      "width": 1180,
      "height": 200,
      "layer": [
        {
          "description": "1.0 Baseline Reference Line",
          "mark": {
            "type": "rule",
            "strokeDash": [4, 4],
            "color": "#64748b",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "datum": 1.0
            }
          }
        },
        {
          "description": "Main Trend Line & Brush Target",
          "params": [
            {
              "name": "time_brush",
              "select": {
                "type": "interval",
                "encodings": ["x"]
              }
            }
          ],
          "mark": {
            "type": "line",
            "color": "#1e293b",
            "strokeWidth": 3.5,
            "cursor": "crosshair"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "domain": [2000, 2020]
              },
              "axis": {
                "format": "d",
                "title": "Year",
                "titleFontSize": 13,
                "labelFontSize": 12,
                "grid": false,
                "values": [
                  2000, 2001, 2002, 2003, 2004,
                  2005, 2006, 2007, 2008, 2009,
                  2010, 2011, 2012, 2013, 2014,
                  2015, 2016, 2017, 2018, 2019,
                  2020
                ]
              }
            },
            "y": {
              "field": "value",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "domain": [0.2, 1.2]
              },
              "axis": {
                "title": "Abundance Index (2000 = 1.0)",
                "titleFontSize": 13,
                "labelFontSize": 12,
                "format": ".1f"
              }
            }
          }
        },
        {
          "description": "Interactive Points & Tooltips",
          "mark": {
            "type": "point",
            "filled": true,
            "size": 60,
            "color": "#334155"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "domain": [2000, 2020]
              }
            },
            "y": {
              "field": "value",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "year",
                "type": "quantitative",
                "title": "Year"
              },
              {
                "field": "value",
                "type": "quantitative",
                "title": "Index Value",
                "format": ".3f"
              }
            ]
          }
        },
        {
          "description": "Annotation 1: EPBC Act enacted at baseline",
          "transform": [
            {
              "filter": "datum.year === 2000"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "dy": -14,
            "fontSize": 12.5,
            "fontWeight": "bold",
            "color": "#0f172a",
            "text": "2000: EPBC Act Enacted (Baseline = 1.0)"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "value",
              "type": "quantitative"
            }
          }
        },
        {
          "description": "Annotation 2: Millennium Drought",
          "transform": [
            {
              "filter": "datum.year === 2005"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "dy": -14,
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#475569",
            "text": "2001–09: Millennium Drought accelerates decline"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "value",
              "type": "quantitative"
            }
          }
        },
        {
          "description": "Endpoint Highlight Point",
          "transform": [
            {
              "filter": "datum.year === 2020"
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 130,
            "color": "#b91c1c"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "value",
              "type": "quantitative"
            }
          }
        },
        {
          "description": "Annotation 3: 2020 Net Collapse Callout",
          "transform": [
            {
              "filter": "datum.year === 2020"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "dy": -30,
            "fontSize": 12.5,
            "fontWeight": "bold",
            "color": "#b91c1c",
            "text": "2020: Net -62.6% Collapse (Index = 0.374)"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "value",
              "type": "quantitative"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "B. Cumulative EPBC Act Statutory Listings by Fauna Class",
        "fontSize": 15,
        "fontWeight": "bold",
        "anchor": "start",
        "frame": "bounds"
      },
      "width": 1180,
      "height": 190,
      "transform": [
        {
          "filter": "datum.year <= 2020"
        },
        {
          "filter": {
            "param": "time_brush"
          }
        },
        {
          "fold": [
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians"
          ],
          "as": [
            "FaunaClass",
            "ListingsCount"
          ]
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": false
          },
          "axis": {
            "format": "d",
            "title": "Filtered Year Window",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "grid": false,
            "values": [
              2000, 2001, 2002, 2003, 2004,
              2005, 2006, 2007, 2008, 2009,
              2010, 2011, 2012, 2013, 2014,
              2015, 2016, 2017, 2018, 2019,
              2020
            ]
          }
        },
        "y": {
          "field": "ListingsCount",
          "type": "quantitative",
          "stack": "center",
          "axis": {
            "title": "Cumulative Listings (Centered Flow)",
            "titleFontSize": 13,
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false
          }
        },
        "color": {
          "field": "FaunaClass",
          "type": "nominal",
          "title": "Fauna Class",
          "scale": {
            "domain": [
              "Birds",
              "Mammals",
              "Reptiles",
              "Amphibians"
            ],
            "range": [
              "#0284c7",
              "#C1C400",
              "#059669",
              "#fc03db"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolSize": 150
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "FaunaClass",
            "type": "nominal",
            "title": "Fauna Class"
          },
          {
            "field": "ListingsCount",
            "type": "quantitative",
            "title": "Listings Count",
            "format": "d"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
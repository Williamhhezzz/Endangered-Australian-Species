{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Sub-Group Divergence Across Animal Classes",
    "subtitle": [
      "Population level relative to 2000 baseline (100% = no change).",
      "Rust Orange = decline (<100%); Turquoise = recovery (>100%)."
    ],
    "fontSize": 18,
    "subtitleFontSize": 13,
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "data": {
    "url": "data/c3_dumbbell.csv"
  },
  "params": [
    {
      "name": "highlight_class",
      "value": null
    }
  ],
  "facet": {
    "row": {
      "field": "class",
      "type": "nominal",
      "title": null,
      "sort": [
        "Amphibians",
        "Reptiles",
        "Birds",
        "Mammals"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelColor": "#0f172a",
        "labelOrient": "left",
        "labelAngle": 0,
        "labelPadding": 12,
        "labelAlign": "left"
      }
    }
  },
  "spec": {
    "width": "container",
    "height": {
      "step": 32
    },
    "encoding": {
      "opacity": {
        "condition": {
          "test": "highlight_class == null || datum.class == highlight_class",
          "value": 1
        },
        "value": 0.15
      }
    },
    "layer": [
      {
        "description": "Connecting Line Between 2000 Baseline and 2022 Level",
        "mark": {
          "type": "rule",
          "color": "#cbd5e1",
          "size": 2.5
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "order"
            },
            "axis": {
              "title": null,
              "labelFontSize": 12.5,
              "labelColor": "#1e293b",
              "labelLimit": 280
            }
          },
          "x": {
            "field": "baseline_2000",
            "type": "quantitative",
            "scale": {
              "domain": [0, 150]
            },
            "axis": {
              "title": "Population Level (% of 2000 Baseline)",
              "titleFontSize": 13,
              "labelFontSize": 12,
              "format": ".0f"
            }
          },
          "x2": {
            "field": "current_2022"
          }
        }
      },
      {
        "description": "100% Baseline Reference Line",
        "mark": {
          "type": "rule",
          "strokeDash": [3, 3],
          "color": "#94a3b8",
          "size": 1.2
        },
        "encoding": {
          "x": {
            "datum": 100
          }
        }
      },
      {
        "description": "2000 Baseline Point",
        "mark": {
          "type": "point",
          "filled": true,
          "size": 75
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "order"
            }
          },
          "x": {
            "field": "baseline_2000",
            "type": "quantitative"
          },
          "color": {
            "datum": "Baseline (100%)",
            "scale": {
              "domain": [
                "Baseline (100%)",
                "Decline (< 100%)",
                "Recovery (>= 100%)"
              ],
              "range": [
                "#94a3b8",
                "#d95f02",
                "#1ae8c6"
              ]
            },
            "legend": {
              "title": "Trend Status",
              "orient": "bottom",
              "direction": "horizontal",
              "labelFontSize": 12.5,
              "titleFontSize": 13,
              "symbolSize": 110,
              "offset": 14
            }
          },
          "tooltip": [
            {
              "field": "class",
              "type": "nominal",
              "title": "Class"
            },
            {
              "field": "subgroup",
              "type": "nominal",
              "title": "Sub-group"
            },
            {
              "field": "baseline_2000",
              "type": "quantitative",
              "title": "2000 Baseline",
              "format": ".0f"
            }
          ]
        }
      },
      {
        "description": "2022 Current Level Point",
        "transform": [
          {
            "calculate": "datum.current_2022 < 100 ? 'Decline (< 100%)' : 'Recovery (>= 100%)'",
            "as": "Trend Status"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 110
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "order"
            }
          },
          "x": {
            "field": "current_2022",
            "type": "quantitative"
          },
          "color": {
            "field": "Trend Status",
            "type": "nominal",
            "title": "Trend Status",
            "scale": {
              "domain": [
                "Baseline (100%)",
                "Decline (< 100%)",
                "Recovery (>= 100%)"
              ],
              "range": [
                "#94a3b8",
                "#d95f02",
                "#1ae8c6"
              ]
            },
            "legend": {
              "title": "Trend Status",
              "orient": "bottom",
              "direction": "horizontal",
              "labelFontSize": 12.5,
              "titleFontSize": 13,
              "symbolSize": 110,
              "offset": 14
            }
          },
          "tooltip": [
            {
              "field": "class",
              "type": "nominal",
              "title": "Class"
            },
            {
              "field": "subgroup",
              "type": "nominal",
              "title": "Sub-group"
            },
            {
              "field": "current_2022",
              "type": "quantitative",
              "title": "2022 Level",
              "format": ".1f"
            },
            {
              "field": "change_pct",
              "type": "nominal",
              "title": "Net Change"
            }
          ]
        }
      },
      {
        "description": "Percentage Change Text Label for Prominent Declines (Beside Dot)",
        "transform": [
          {
            "filter": "datum.current_2022 < 100 && (datum.subgroup === 'Land-breeding frogs' || datum.subgroup === 'Frogs not hit by chytrid fungus' || datum.subgroup === 'Migratory shorebirds' || datum.subgroup === 'Mid-sized mammals (35g–5.5kg)')"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 8,
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#d95f02"
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "order"
            }
          },
          "x": {
            "field": "current_2022",
            "type": "quantitative"
          },
          "text": {
            "field": "change_pct",
            "type": "nominal"
          }
        }
      },
      {
        "description": "Percentage Change Text Label for Prominent Recovery (Beside Dot)",
        "transform": [
          {
            "filter": "datum.current_2022 >= 100 && datum.subgroup === 'Marine mammals'"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 8,
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#0f766e"
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "order"
            }
          },
          "x": {
            "field": "current_2022",
            "type": "quantitative"
          },
          "text": {
            "field": "change_pct",
            "type": "nominal"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "facet": {
      "spacing": 14
    },
    "header": {
      "title": null
    },
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Population Change Across Animal Sub-Groups (2000–2022)",
    "subtitle": [
      "Population level relative to 2000 baseline (100% = no change).",
      "Rust Orange = decline (<100%); Turquoise = recovery (>100%)."
    ],
    "font": "Inter, sans-serif",
    "fontSize": 22,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 15.5,
    "subtitleColor": "#475569",
    "anchor": "start",
    "frame": "bounds",
    "offset": 14
  },
  "data": {
    "url": "data/c3_dumbbell.csv"
  },
  "params": [
    {
      "name": "highlight_class",
      "value": null
    }
  ],
  "facet": {
    "row": {
      "field": "class",
      "type": "nominal",
      "title": null,
      "sort": [
        "Amphibians",
        "Reptiles",
        "Birds",
        "Mammals"
      ],
      "header": {
        "labelFont": "Inter, sans-serif",
        "labelFontSize": 17.5,
        "labelFontWeight": "bold",
        "labelColor": "#0f172a",
        "labelOrient": "left",
        "labelAngle": 0,
        "labelPadding": 12,
        "labelAlign": "left"
      }
    }
  },
  "spec": {
    "width": "container",
    "height": {
      "step": 42
    },
    "encoding": {
      "opacity": {
        "condition": {
          "test": "highlight_class == null || datum.class == highlight_class",
          "value": 1
        },
        "value": 0.15
      }
    },
    "layer": [
      {
        "description": "Connecting Line Between 2000 Baseline and 2022 Level",
        "mark": {
          "type": "rule",
          "color": "#cbd5e1",
          "size": 3
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            },
            "axis": {
              "title": null,
              "labelFontSize": 16,
              "labelFontWeight": 600,
              "labelColor": "#1e293b",
              "labelLimit": 380
            }
          },
          "x": {
            "field": "baseline_2000",
            "type": "quantitative",
            "scale": {
              "domain": [0, 150]
            },
            "axis": {
              "title": "Population Level (% of 2000 Baseline)",
              "titleFontSize": 16.5,
              "titleFontWeight": "bold",
              "labelFontSize": 15,
              "format": ".0f"
            }
          },
          "x2": {
            "field": "current_2022"
          }
        }
      },
      {
        "description": "100% Baseline Reference Line",
        "mark": {
          "type": "rule",
          "strokeDash": [3, 3],
          "color": "#94a3b8",
          "size": 1.2
        },
        "encoding": {
          "x": {
            "datum": 100
          }
        }
      },
      {
        "description": "2000 Baseline Point",
        "mark": {
          "type": "point",
          "filled": true,
          "size": 90
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "field": "baseline_2000",
            "type": "quantitative"
          },
          "color": {
            "datum": "Baseline (100%)",
            "scale": {
              "domain": [
                "Baseline (100%)",
                "Decline (< 100%)",
                "Recovery (>= 100%)"
              ],
              "range": [
                "#94a3b8",
                "#d95f02",
                "#1ae8c6"
              ]
            },
            "legend": {
              "title": "Trend Status",
              "orient": "bottom",
              "direction": "horizontal",
              "labelFontSize": 15,
              "titleFontSize": 16,
              "symbolSize": 180,
              "offset": 14
            }
          },
          "tooltip": [
            {
              "field": "class",
              "type": "nominal",
              "title": "Class"
            },
            {
              "field": "subgroup",
              "type": "nominal",
              "title": "Sub-group"
            },
            {
              "field": "baseline_2000",
              "type": "quantitative",
              "title": "2000 Baseline",
              "format": ".0f"
            }
          ]
        }
      },
      {
        "description": "2022 Current Level Point",
        "transform": [
          {
            "calculate": "datum.current_2022 < 100 ? 'Decline (< 100%)' : 'Recovery (>= 100%)'",
            "as": "Trend Status"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 140
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "field": "current_2022",
            "type": "quantitative"
          },
          "color": {
            "field": "Trend Status",
            "type": "nominal",
            "title": "Trend Status",
            "scale": {
              "domain": [
                "Baseline (100%)",
                "Decline (< 100%)",
                "Recovery (>= 100%)"
              ],
              "range": [
                "#94a3b8",
                "#d95f02",
                "#1ae8c6"
              ]
            },
            "legend": {
              "title": "Trend Status",
              "orient": "bottom",
              "direction": "horizontal",
              "labelFontSize": 15,
              "titleFontSize": 16,
              "symbolSize": 180,
              "offset": 14
            }
          },
          "tooltip": [
            {
              "field": "class",
              "type": "nominal",
              "title": "Class"
            },
            {
              "field": "subgroup",
              "type": "nominal",
              "title": "Sub-group"
            },
            {
              "field": "current_2022",
              "type": "quantitative",
              "title": "2022 Level",
              "format": ".1f"
            },
            {
              "field": "change_pct",
              "type": "nominal",
              "title": "Net Change"
            }
          ]
        }
      },
      {
        "description": "Percentage Change Text Label for Prominent Declines (Beside Dot)",
        "transform": [
          {
            "filter": "datum.current_2022 < 100 && (datum.subgroup === 'Land-breeding frogs' || indexof(datum.subgroup, 'Mid-sized mammals') >= 0)"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 10,
          "fontSize": 15,
          "fontWeight": "bold",
          "color": "#d95f02"
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "field": "current_2022",
            "type": "quantitative"
          },
          "text": {
            "field": "change_pct",
            "type": "nominal"
          }
        }
      },
      {
        "description": "Percentage Change Text Label for Prominent Recovery (Beside Dot)",
        "transform": [
          {
            "filter": "datum.current_2022 >= 100 && datum.subgroup === 'Marine mammals'"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 10,
          "fontSize": 15,
          "fontWeight": "bold",
          "color": "#0f766e"
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "field": "current_2022",
            "type": "quantitative"
          },
          "text": {
            "field": "change_pct",
            "type": "nominal"
          }
        }
      },
      {
        "description": "Multi-line Insight 1: Chytrid-free frogs",
        "transform": [
          {
            "filter": "datum.subgroup === 'Frogs not hit by chytrid fungus'"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "fontSize": 14.5,
          "fontWeight": 600,
          "fill": "#1e293b",
          "text": [
            "Even chytrid-free frogs fell 72.8%,",
            "showing wetland drying and heat",
            "act alongside fungal disease."
          ]
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "datum": 106
          }
        }
      },
      {
        "description": "Multi-line Insight 2: Shorebird stopovers",
        "transform": [
          {
            "filter": "datum.subgroup === 'Terrestrial birds'"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "fontSize": 14.5,
          "fontWeight": 600,
          "fill": "#1e293b",
          "text": [
            "Migratory shorebirds fell 56.4%",
            "as overseas coastal stopover",
            "mudflats are reclaimed."
          ]
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "datum": 105
          }
        }
      },
      {
        "description": "Multi-line Insight 3: Mid-sized vs marine mammals",
        "transform": [
          {
            "filter": "datum.subgroup === 'Small land mammals'"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "fontSize": 14.5,
          "fontWeight": 600,
          "fill": "#1e293b",
          "text": [
            "Cats & foxes hunt mid-sized",
            "marsupials (-47.9%), while whaling",
            "bans aided marine mammals (+42.9%)."
          ]
        },
        "encoding": {
          "y": {
            "field": "subgroup",
            "type": "nominal",
            "sort": {
              "field": "current_2022",
              "order": "ascending"
            }
          },
          "x": {
            "datum": 105
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 22,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 15.5,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 16.5,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 15,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 15,
      "labelColor": "#334155"
    },
    "header": {
      "title": null,
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 17.5,
      "labelFontWeight": "bold",
      "labelColor": "#0f172a"
    },
    "facet": {
      "spacing": 16
    },
    "view": {
      "stroke": null
    }
  }
}
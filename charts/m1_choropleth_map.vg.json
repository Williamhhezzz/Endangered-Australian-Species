
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "title": {
    "text": "State-Level Wildlife Population Decline (2000–2022)",
    "subtitle": "Average percentage change in monitored fauna relative to 2000 baseline (NSW & ACT combined).",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "anchor": "start",
    "frame": "bounds",
    "offset": 10
  },
  "params": [
    {
      "name": "highlight_state",
      "value": null
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0, 0],
    "parallels": [-18, -36],
    "center": [0, -27],
    "translate": [250, 200],
    "scale": 640
  },
  "layer": [
    {
      "description": "Layer 1: Base Map Outline",
      "data": {
        "url": "data/ne_10m_admin_1_states_provinces.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Layer 2: Choropleth Layer",
      "data": {
        "url": "data/m1_chloropleth.csv"
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/ne_10m_admin_1_states_provinces.json",
              "format": {
                "type": "topojson",
                "feature": "ne_10m_admin_1_states_provinces"
              }
            },
            "key": "properties.name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "cursor": "pointer"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "pct_change",
          "type": "quantitative",
          "title": "% Change (2000–2022)",
          "scale": {
            "type": "linear",
            "domain": [-65, -30],
            "range": [
              "#7f1d1d",
              "#fff7ed"
            ]
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "horizontal",
            "format": ".1f",
            "tickCount": 4,
            "titleFontSize": 12.5,
            "labelFontSize": 11,
            "gradientLength": 130,
            "offset": 8
          }
        },
        "opacity": {
          "condition": {
            "test": "highlight_state == null || datum.state_name == highlight_state",
            "value": 1
          },
          "value": 0.2
        },
        "stroke": {
          "condition": {
            "test": "highlight_state != null && datum.state_name == highlight_state",
            "value": "#0f172a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "highlight_state != null && datum.state_name == highlight_state",
            "value": 2.5
          },
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "pct_change",
            "type": "quantitative",
            "title": "Net Change (2000–2022)",
            "format": ".1f"
          },
          {
            "field": "pct_remaining",
            "type": "nominal",
            "title": "2022 Population Level"
          },
          {
            "field": "taxa_count",
            "type": "quantitative",
            "title": "Species Tracked"
          },
          {
            "field": "time_series_count",
            "type": "quantitative",
            "title": "Monitoring Datasets",
            "format": ","
          }
        ]
      }
    },
    {
      "description": "Annotation: Over Northern Territory",
      "data": {
        "values": [
          {
            "longitude": 133.5,
            "latitude": -20.0,
            "text": "Northern Territory (-61.8%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#ffffff"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Annotation: Over Victoria",
      "data": {
        "values": [
          {
            "longitude": 144.5,
            "latitude": -36.8,
            "text": "Victoria (-62.3%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#ffffff"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Pointer line to Tasmania",
      "data": {
        "values": [
          { "lon": 147.2, "lat": -42.2 },
          { "lon": 149.2, "lat": -42.2 }
        ]
      },
      "mark": {
        "type": "line",
        "color": "#1e293b",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Annotation: Pointer to Tasmania text",
      "data": {
        "values": [
          {
            "longitude": 149.5,
            "latitude": -42.2,
            "text": "Tasmania (-32.5%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1e293b"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "text",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 440,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "padding": {"top": 15},
  "title": {
    "text": "State-Level Wildlife Population Decline (2000–2022)",
    "subtitle": "(New South Wales & Australian Capital Territory combined)",
    "subtitleLimit": 580,
    "limit": 580,
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 11.5,
    "subtitleColor": "#475569",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "params": [
    {
      "name": "highlight_state",
      "value": null
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0, 0],
    "parallels": [-18, -36],
    "center": [0, -26.0],
    "scale": 580,
    "translate": [240, 220]
  },
  "layer": [
    {
      "description": "Layer 1: Base Map Outline",
      "data": {
        "url": "data/ne_10m_admin_1_states_provinces.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f5f9",
        "stroke": "#cbd5e1",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Layer 2: Choropleth Layer",
      "data": {
        "url": "data/m1_chloropleth.csv"
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/ne_10m_admin_1_states_provinces.json",
              "format": {
                "type": "topojson",
                "feature": "ne_10m_admin_1_states_provinces"
              }
            },
            "key": "properties.name"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.pct_change",
          "as": "pct_change_num"
        },
        {
          "calculate": "format(datum.pct_change, '.1f') + '%'",
          "as": "pct_change"
        }
      ],
      "mark": {
        "type": "geoshape",
        "cursor": "pointer"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "pct_change_num",
          "type": "quantitative",
          "title": "Change Since 2000 (%)",
          "scale": {
            "type": "linear",
            "domain": [-65, -30],
            "range": [
              "#9a3412",
              "#ea580c",
              "#fdba74",
              "#ffedd5"
            ]
          },
          "legend": {
            "orient": "none",
            "legendX": 445,
            "legendY": 35,
            "direction": "vertical",
            "format": ".1f",
            "tickCount": 4,
            "titleFontSize": 12.5,
            "titleLimit": 180,
            "labelFontSize": 11,
            "gradientLength": 130,
            "offset": 8,
            "padding": 12
          }
        },
        "opacity": {
          "condition": {
            "test": "highlight_state == null || datum.state_name == highlight_state",
            "value": 1
          },
          "value": 0.2
        },
        "stroke": {
          "condition": {
            "test": "highlight_state != null && datum.state_name == highlight_state",
            "value": "#0f172a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "highlight_state != null && datum.state_name == highlight_state",
            "value": 2.5
          },
          "value": 1.2
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "pct_change",
            "type": "nominal",
            "title": "Population Change"
          },
          {
            "field": "pct_remaining",
            "type": "nominal",
            "title": "2022 Remaining Level"
          }
        ]
      }
    },
    {
      "description": "Leader lines to ocean annotations",
      "data": {
        "values": [
          { "lon1": 132.5, "lat1": -15.5, "lon2": 126.5, "lat2": -12.2 },
          { "lon1": 144.5, "lat1": -37.0, "lon2": 139.0, "lat2": -39.2 },
          { "lon1": 146.5, "lat1": -42.0, "lon2": 149.0, "lat2": -42.0 }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#475569",
        "strokeWidth": 1,
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon1",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat1",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "description": "Annotation: Ocean label for NT",
      "data": {
        "values": [
          {
            "lon": 118.0,
            "lat": -9.8,
            "text": [
              "Northern Territory (-61.8%):",
              "Wildfires & toxic cane toads"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1e293b",
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "description": "Annotation: Ocean label for Victoria",
      "data": {
        "values": [
          {
            "lon": 138.5,
            "lat": -39.5,
            "text": [
              "Victoria (-62.3%):",
              "Historic farmland clearing"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1e293b",
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "description": "Annotation: Ocean label for Tasmania",
      "data": {
        "values": [
          {
            "lon": 149.3,
            "lat": -42.0,
            "text": [
              "Tasmania (-32.5%):",
              "Sea barrier blocked foxes"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#1e293b",
        "clip": false
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 11.5,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 Invasive Species by Threatened Species Harmed",
    "font": "Inter, sans-serif",
    "fontSize": 20.5,
    "fontWeight": "bold",
    "color": "#0f172a",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/c7_invasive_species.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Species_Affected": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.Invasive_Species === 'Phytophthora cinnamomi (Plant pathogen)' ? 'Root-rot mould (Phytophthora)' : datum.Invasive_Species",
      "as": "Invasive_Species_Clean"
    }
  ],
  "encoding": {
    "y": {
      "field": "Invasive_Species",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "titleFontSize": 13,
        "titleFontWeight": "bold",
        "titleColor": "#334155",
        "labelFontSize": 12.5,
        "labelColor": "#0f172a",
        "ticks": true,
        "tickColor": "#94a3b8",
        "domain": true,
        "domainColor": "#94a3b8",
        "domainWidth": 1.5,
        "labelLimit": 260,
        "labelExpr": "datum.value === 'Phytophthora cinnamomi (Plant pathogen)' ? 'Root-rot mould (Phytophthora)' : datum.value"
      }
    },
    "x": {
      "field": "Species_Affected",
      "type": "quantitative",
      "title": "Listed Species Affected",
      "scale": {
        "domain": [0, 360]
      },
      "axis": {
        "grid": false,
        "titleFontSize": 13,
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "description": "Layer 1: Lollipop Stem",
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "Species_Affected"
        }
      }
    },
    {
      "description": "Layer 2: Lollipop Circle Endpoint",
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Species_Affected >= 322",
            "value": "#0f172a"
          },
          "value": "#94a3b8"
        },
        "tooltip": [
          {
            "field": "Invasive_Species_Clean",
            "type": "nominal",
            "title": "Invasive Threat"
          },
          {
            "field": "Species_Affected",
            "type": "quantitative",
            "title": "Listed Species Affected"
          }
        ]
      }
    },
    {
      "description": "Layer 3: Direct Numeric Count on Top Outlier Only",
      "transform": [
        {
          "filter": "datum.Species_Affected >= 322"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#0f172a"
      },
      "encoding": {
        "x": {
          "field": "Species_Affected",
          "type": "quantitative"
        },
        "text": {
          "field": "Species_Affected",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Insight Annotation: Habitat destroying invaders",
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#334155",
        "x": 215,
        "y": 175
      },
      "encoding": {
        "x": {
          "value": 215
        },
        "y": {
          "value": 175
        },
        "text": {
          "value": [
            "3 of the top 10 invaders are",
            "weeds & mould destroying habitat"
          ]
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 20.5,
      "fontWeight": "bold",
      "color": "#0f172a"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Deadliest Invaders",
    "subtitle": "Number of nationally listed species (animals and plants) impacted by top invasive threats.",
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#475569",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/c7_invasive_species.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Species_Affected": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "Invasive_Species",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 12.5,
        "labelColor": "#0f172a",
        "ticks": false,
        "domain": false,
        "labelLimit": 260
      }
    },
    "x": {
      "field": "Species_Affected",
      "type": "quantitative",
      "title": "Listed Species Affected",
      "scale": {
        "domain": [0, 360]
      },
      "axis": {
        "grid": true,
        "titleFontSize": 13,
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "description": "Layer 1: Lollipop Stem",
      "mark": {
        "type": "rule",
        "color": "#cbd5e1",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "Species_Affected"
        }
      }
    },
    {
      "description": "Layer 2: Lollipop Circle Endpoint",
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Species_Affected >= 322",
            "value": "#0f172a"
          },
          "value": "#94a3b8"
        },
        "tooltip": [
          {
            "field": "Invasive_Species",
            "type": "nominal",
            "title": "Invasive Threat"
          },
          {
            "field": "Species_Affected",
            "type": "quantitative",
            "title": "Listed Species Affected"
          }
        ]
      }
    },
    {
      "description": "Layer 3: Direct Numeric Count on Top Outlier Only",
      "transform": [
        {
          "filter": "datum.Species_Affected >= 322"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#0f172a"
      },
      "encoding": {
        "x": {
          "field": "Species_Affected",
          "type": "quantitative"
        },
        "text": {
          "field": "Species_Affected",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Layer 4: Callout Annotation for Habitat Loss Outranks Predators",
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fill": "#334155",
        "text": [
          "Habitat Loss Outranks Predators:",
          "Rabbits (322) & root-rot mould (236)",
          "harm more species than cats (123)",
          "by destroying food & shelter plants."
        ]
      },
      "encoding": {
        "x": {
          "datum": 155
        },
        "y": {
          "datum": "Blackberry (Weed)"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
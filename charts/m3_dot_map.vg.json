
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Conservation Surveillance Networks Across Fauna Classes",
    "subtitle": "Each point represents an active ecological monitoring site. Source: TSX 2025.",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "anchor": "start",
    "offset": 12
  },
  "params": [
    {
      "name": "highlight_state",
      "value": null
    }
  ],
  "spacing": -200,
  "vconcat": [
    {
      "spacing": 50,
      "hconcat": [
        {
          "title": {
            "text": "Birds",
            "fontSize": 13,
            "fontWeight": "bold",
            "anchor": "start"
          },
          "width": 620,
          "height": 440,
          "projection": {
            "type": "equirectangular"
          },
          "layer": [
            {
              "data": {
                "url": "data/ne_10m_admin_1_states_provinces.json",
                "format": {
                  "type": "topojson",
                  "feature": "ne_10m_admin_1_states_provinces"
                }
              },
              "mark": {
                "type": "geoshape",
                "fill": "#f1f5f9",
                "stroke": "#cbd5e1",
                "strokeWidth": 0.8,
                "cursor": "pointer"
              }
            },
            {
              "data": {
                "url": "data/m3_dot_map.csv"
              },
              "transform": [
                {
                  "filter": "datum.TaxonomicGroup == 'Birds'"
                }
              ],
              "mark": {
                "type": "circle",
                "size": 32,
                "stroke": "#0f172a",
                "strokeWidth": 0.5,
                "cursor": "pointer"
              },
              "encoding": {
                "longitude": {
                  "field": "longitude",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "latitude",
                  "type": "quantitative"
                },
                "color": {
                  "value": "#0284c7"
                },
                "opacity": {
                  "condition": {
                    "test": "highlight_state == null || datum.State == highlight_state",
                    "value": 0.85
                  },
                  "value": 0.05
                },
                "strokeOpacity": {
                  "condition": {
                    "test": "highlight_state == null || datum.State == highlight_state",
                    "value": 0.85
                  },
                  "value": 0.05
                },
                "order": {
                  "condition": {
                    "test": "highlight_state != null && datum.State == highlight_state",
                    "value": 1
                  },
                  "value": 0
                },
                "tooltip": [
                  {
                    "field": "TaxonomicGroup",
                    "type": "nominal",
                    "title": "Fauna Group"
                  },
                  {
                    "field": "State",
                    "type": "nominal",
                    "title": "State / Territory"
                  },
                  {
                    "field": "species_count",
                    "type": "quantitative",
                    "title": "Species Tracked at Site"
                  },
                  {
                    "field": "species_monitored",
                    "type": "nominal",
                    "title": "Species List"
                  },
                  {
                    "field": "EPBCStatus",
                    "type": "nominal",
                    "title": "EPBC Status"
                  },
                  {
                    "field": "latitude",
                    "type": "quantitative",
                    "title": "Latitude",
                    "format": ".2f"
                  },
                  {
                    "field": "longitude",
                    "type": "quantitative",
                    "title": "Longitude",
                    "format": ".2f"
                  }
                ]
              }
            }


{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "title": {
    "text": "Threatened Fauna Listings Across Australian Jurisdictions",
    "subtitle": "Number of legally listed threatened species by state and animal group. Click any cell to isolate.",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitlePadding": 6,
    "offset": 13,
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/c4_heatmap.csv"
  },
  "transform": [
    {"calculate": "datum.State == 'NSW' ? 'New South Wales' : datum.State == 'QLD' ? 'Queensland' : datum.State == 'VIC' ? 'Victoria' : datum.State == 'WA' ? 'Western Australia' : datum.State == 'SA' ? 'South Australia' : datum.State == 'NT' ? 'Northern Territory' : datum.State == 'TAS' ? 'Tasmania' : 'Aust. Capital Territory'", "as": "FullState"}
  ],
  "encoding": {
    "x": {
      "field": "FullState",
      "type": "nominal",
      "title": "State / Territory",
      "axis": {
        "labelAngle": -30,
        "titleFontSize": 13,
        "labelFontSize": 11,
        "titlePadding": 10,
        "domain": false,
        "ticks": false
      },
      "sort": [
        "Aust. Capital Territory",
        "New South Wales",
        "Northern Territory",
        "Queensland",
        "South Australia",
        "Tasmania",
        "Victoria",
        "Western Australia"
      ]
    },
    "y": {
      "field": "TaxonomicGroup",
      "type": "nominal",
      "title": "Fauna Class",
      "sort": [
        "Birds",
        "Mammals",
        "Reptiles",
        "Amphibians"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "titleFontSize": 13,
        "labelFontSize": 12.5
      }
    }
  },
  "layer": [
    {
      "description": "Layer 1: Heatmap Rectangles with Interactive Focus State",
      "params": [
        {
          "name": "cell_select",
          "select": {
            "type": "point"
          }
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "species_count",
          "type": "quantitative",
          "title": "Listed Species",
          "scale": {
            "type": "linear",
            "range": [
              "#f5f3ff",
              "#c084fc",
              "#7e22ce",
              "#3b0764"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "gradientLength": 240,
            "gradientThickness": 15,
            "offset": 10
          }
        },
        "opacity": {
          "condition": {
            "param": "cell_select",
            "value": 1
          },
          "value": 0.25
        },
        "stroke": {
          "condition": {
            "param": "cell_select",
            "empty": false,
            "value": "#0f172a"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "param": "cell_select",
            "empty": false,
            "value": 2.5
          },
          "value": 2
        },
        "tooltip": [
          {
            "field": "TaxonomicGroup",
            "type": "nominal",
            "title": "Fauna Group"
          },
          {
            "field": "FullState",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Threatened Species"
          }
        ]
      }
    },
    {
      "description": "Layer 2: Cell Value Text Annotations",
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "baseline": "middle",
        "cursor": "pointer"
      },
      "encoding": {
        "text": {
          "field": "species_count",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.species_count > 50",
            "value": "#ffffff"
          },
          "value": "#1e293b"
        },
        "opacity": {
          "condition": {
            "param": "cell_select",
            "value": 1
          },
          "value": 0.25
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "grid": false
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Top Threat Pressures Affecting Listed Species",
    "subtitle": [
      "Percentage of listed threatened species impacted",
      "by each major threat (multiple threats possible)."
    ],
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#475569",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "data": {
    "url": "data/c6_threat_pressures.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Proportion": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "format(datum.Proportion, '.1f') + '%'",
      "as": "pct_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "Threat",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Proportion",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 12.5,
        "labelColor": "#0f172a",
        "labelLimit": 260
      }
    },
    "x": {
      "field": "Proportion",
      "type": "quantitative",
      "title": "Percentage of Listed Species Impacted (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "format": "d",
        "grid": false,
        "values": [0, 20, 40, 60, 80, 100],
        "titleFontSize": 13,
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "description": "Layer 1: Horizontal Bars",
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Threat === 'Invasive species/genes'",
            "value": "#0f172a"
          },
          "value": "#94a3b8",
          "legend": null
        },
        "tooltip": [
          {
            "field": "Threat",
            "type": "nominal",
            "title": "Threat Pressure"
          },
          {
            "field": "Proportion",
            "type": "quantitative",
            "title": "Species Affected (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "description": "Layer 2: Direct Numeric Percentage Text Label on Top Bar Only",
      "transform": [
        {
          "filter": "datum.Threat === 'Invasive species/genes'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#0f172a"
      },
      "encoding": {
        "text": {
          "field": "pct_label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Layer 3: Callout Annotation for Fire & Predator Trap",
      "transform": [
        {
          "filter": "datum.Threat === 'Transportation and service corridors'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dy": -12,
        "fontSize": 11,
        "fill": "#1e293b",
        "fontStyle": "normal"
      },
      "encoding": {
        "x": {
          "datum": 36
        },
        "y": {
          "field": "Threat",
          "type": "nominal"
        },
        "text": {
          "value": [
            "Compounding Pressures:",
            "The top 3 threats each impact",
            "over 50% of listed species,",
            "meaning most face multiple",
            "overlapping threats at once."
          ]
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
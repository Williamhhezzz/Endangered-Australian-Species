{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "title": {
    "text": "Extinction Risk Severity Across Animal Groups",
    "subtitle": "Proportion of listed species in each legal risk tier.",
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#475569",
    "subtitlePadding": 6,
    "offset": 14,
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/c5_stacked_bar.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "species_count",
          "as": "group_total"
        }
      ],
      "groupby": [
        "TaxonomicGroup"
      ]
    },
    {
      "calculate": "datum.species_count / datum.group_total",
      "as": "proportion"
    }
  ],
  "layer": [
    {
      "description": "Layer 1: 100% Stacked Horizontal Bars",
      "params": [
        {
          "name": "status_select",
          "select": {
            "type": "point",
            "fields": ["EPBCStatus"]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar",
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "TaxonomicGroup",
          "type": "nominal",
          "title": "Animal Group",
          "sort": [
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians"
          ],
          "axis": {
            "titleFontSize": 13,
            "labelFontSize": 12.5
          }
        },
        "x": {
          "field": "species_count",
          "type": "quantitative",
          "stack": "normalize",
          "title": "Proportion of Listed Species",
          "axis": {
            "format": "%",
            "grid": true,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "field": "EPBCStatus",
          "type": "ordinal",
          "title": "Extinction Risk Tier",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable"
          ],
          "scale": {
            "domain": [
              "Critically Endangered",
              "Endangered",
              "Vulnerable"
            ],
            "range": [
              "#991b1b",
              "#ef4444",
              "#f59e0b"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolSize": 180,
            "columnPadding": 20,
            "offset": 10
          }
        },
        "opacity": {
          "condition": {
            "param": "status_select",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "TaxonomicGroup",
            "type": "nominal",
            "title": "Animal Group"
          },
          {
            "field": "EPBCStatus",
            "type": "nominal",
            "title": "EPBC Status"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Species Count"
          },
          {
            "field": "group_total",
            "type": "quantitative",
            "title": "Total Listed Species"
          },
          {
            "field": "proportion",
            "type": "quantitative",
            "title": "Proportion",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "description": "Layer 2: Clean percentage labels on Critically Endangered bars",
      "transform": [
        {
          "filter": "datum.EPBCStatus === 'Critically Endangered'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#ffffff"
      },
      "encoding": {
        "y": {
          "field": "TaxonomicGroup",
          "type": "nominal",
          "sort": [
            "Birds",
            "Mammals",
            "Reptiles",
            "Amphibians"
          ]
        },
        "x": {
          "datum": 0
        },
        "text": {
          "field": "proportion",
          "type": "quantitative",
          "format": ".1%"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
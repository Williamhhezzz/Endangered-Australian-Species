{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 295,
  "title": {
    "text": "Government Priority Funding Coverage Across Animal Groups",
    "subtitle": [
      "Proportion of legally listed threatened species selected as one of the 110 Priority Species",
      "under the 2022–2032 Federal Action Plan (14.0% overall coverage)."
    ],
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#475569",
    "subtitlePadding": 6,
    "offset": 14,
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/c10_priority_coverage.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "species_count",
          "as": "group_total"
        }
      ],
      "groupby": [
        "TaxonomicGroup"
      ]
    },
    {
      "calculate": "datum.species_count / datum.group_total",
      "as": "proportion"
    }
  ],
  "encoding": {
    "y": {
      "field": "TaxonomicGroup",
      "type": "nominal",
      "title": "Animal Group",
      "sort": [
        "Birds",
        "Mammals",
        "Reptiles",
        "Amphibians"
      ],
      "axis": {
        "titleFontSize": 13,
        "labelFontSize": 12.5
      }
    }
  },
  "layer": [
    {
      "description": "Layer 1: 100% Stacked Horizontal Bars",
      "params": [
        {
          "name": "action_select",
          "select": {
            "type": "point",
            "fields": [
              "ActionStatus"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "bar",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "species_count",
          "type": "quantitative",
          "stack": "normalize",
          "title": "Proportion of Listed Species",
          "axis": {
            "format": "%",
            "grid": true,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "field": "ActionStatus",
          "type": "nominal",
          "title": "Recovery Plan Status",
          "sort": [
            "Action Plan Priority",
            "Other Listed Species"
          ],
          "scale": {
            "domain": [
              "Action Plan Priority",
              "Other Listed Species"
            ],
            "range": [
              "#DCBE2E",
              "#cbd5e1"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolSize": 180,
            "columnPadding": 20,
            "offset": 10,
            "cursor": "pointer"
          }
        },
        "opacity": {
          "condition": {
            "param": "action_select",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "TaxonomicGroup",
            "type": "nominal",
            "title": "Fauna Group"
          },
          {
            "field": "ActionStatus",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Species Count"
          },
          {
            "field": "group_total",
            "type": "quantitative",
            "title": "Total Listed Species"
          },
          {
            "field": "proportion",
            "type": "quantitative",
            "title": "Proportion",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "description": "Layer 2: Clean Priority percentage labels on Priority bars",
      "transform": [
        {
          "filter": "datum.ActionStatus === 'Action Plan Priority'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#0f172a"
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "text": {
          "field": "proportion",
          "type": "quantitative",
          "format": ".1%"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
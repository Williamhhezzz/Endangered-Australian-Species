{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Land Clearing Impact: Absolute Habitat Area Lost vs. Proportional Range Destruction",
    "subtitle": "Comparing total clearing footprint (Million Ha) against percentage of historical range destroyed.",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "data": {
    "url": "data/c8_habitat_loss.csv"
  },
  "spacing": 20,
  "hconcat": [
    {
      "title": {
        "text": "Absolute Area Cleared (Million Hectares)",
        "fontSize": 14,
        "fontWeight": "bold",
        "anchor": "middle"
      },
      "width": 440,
      "height": 300,
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Area_Lost_Millions",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 12.5,
            "labelFontWeight": "bold",
            "labelColor": "#0f172a",
            "labelLimit": 260
          }
        },
        "x": {
          "field": "Area_Lost_Millions",
          "type": "quantitative",
          "title": "Area Lost (Million Ha)",
          "scale": {
            "reverse": true
          },
          "axis": {
            "format": ".1f",
            "grid": true,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "value": "#1dc1f2"
        },
        "tooltip": [
          {
            "field": "Species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "Area_Lost_Millions",
            "type": "quantitative",
            "title": "Area Lost (M ha)",
            "format": ".2f"
          },
          {
            "field": "Proportion_Lost",
            "type": "quantitative",
            "title": "Proportion Lost (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "title": {
        "text": "Proportional Range Destroyed (%)",
        "fontSize": 14,
        "fontWeight": "bold",
        "anchor": "middle"
      },
      "width": 440,
      "height": 300,
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Area_Lost_Millions",
            "order": "descending"
          },
          "axis": null
        },
        "x": {
          "field": "Proportion_Lost",
          "type": "quantitative",
          "title": "Proportion of Habitat Lost (%)",
          "axis": {
            "format": ".1f",
            "grid": true,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "value": "#32f21d"
        },
        "tooltip": [
          {
            "field": "Species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "Proportion_Lost",
            "type": "quantitative",
            "title": "Proportion Lost (%)",
            "format": ".2f"
          },
          {
            "field": "Area_Lost_Millions",
            "type": "quantitative",
            "title": "Area Lost (M ha)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
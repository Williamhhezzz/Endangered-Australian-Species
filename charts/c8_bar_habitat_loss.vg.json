{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Land Clearing: Total Area Lost vs. Habitat Share Destroyed",
    "subtitle": [
      "Comparing total habitat cleared (Million Hectares, left)",
      "against share of potential habitat destroyed (%, right)."
    ],
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#475569",
    "anchor": "middle",
    "frame": "bounds",
    "offset": 12
  },
  "padding": {"left": 15, "right": 15, "top": 10, "bottom": 10},
  "data": {
    "url": "data/c8_habitat_loss.csv"
  },
  "spacing": 20,
  "hconcat": [
    {
      "title": {
        "text": "Absolute Area Cleared (Million Hectares)",
        "font": "Inter, sans-serif",
        "fontSize": 13.5,
        "fontWeight": "bold",
        "color": "#1e293b",
        "anchor": "middle"
      },
      "width": 530,
      "height": 340,
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": [
            "Red goshawk",
            "Ghost bat",
            "Star finch",
            "Northern quoll",
            "Bluegrass",
            "Painted honeyeater",
            "Squatter pigeon",
            "Malleefowl",
            "Koala",
            "Southern black-throated finch"
          ],
          "axis": {
            "labelFontSize": 12.5,
            "labelFontWeight": "bold",
            "labelColor": "#0f172a",
            "labelLimit": 260
          }
        },
        "x": {
          "field": "Area_Lost_Millions",
          "type": "quantitative",
          "title": "Area Lost (Million Ha)",
          "scale": {
            "reverse": true,
            "domain": [0, 4.0]
          },
          "axis": {
            "format": ".1f",
            "grid": true,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 3
          },
          "encoding": {
            "color": {
              "value": "#3b6998"
            },
            "tooltip": [
              {
                "field": "Species",
                "type": "nominal",
                "title": "Species"
              },
              {
                "field": "Area_Lost_Millions",
                "type": "quantitative",
                "title": "Area Lost (M ha)",
                "format": ".2f"
              },
              {
                "field": "Proportion_Lost",
                "type": "quantitative",
                "title": "Proportion Lost (%)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "description": "Numeric Label on Red goshawk tip",
          "transform": [
            {
              "filter": "datum.Species === 'Red goshawk'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -6,
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#3b6998",
            "text": "3.02M"
          }
        },
        {
          "description": "Annotation for Red Goshawk habitat context",
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10.5,
            "fill": "#334155"
          },
          "encoding": {
            "x": {
              "datum": 3.8
            },
            "y": {
              "datum": "Koala"
            },
            "text": {
              "value": [
                "Red Goshawk lost 3.02M ha,",
                "but that is only 2.4% of its",
                "vast continental range."
              ]
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "Proportional Range Destroyed (%)",
        "font": "Inter, sans-serif",
        "fontSize": 13.5,
        "fontWeight": "bold",
        "color": "#1e293b",
        "anchor": "middle"
      },
      "width": 530,
      "height": 340,
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": [
            "Red goshawk",
            "Ghost bat",
            "Star finch",
            "Northern quoll",
            "Bluegrass",
            "Painted honeyeater",
            "Squatter pigeon",
            "Malleefowl",
            "Koala",
            "Southern black-throated finch"
          ],
          "axis": null
        },
        "x": {
          "field": "Proportion_Lost",
          "type": "quantitative",
          "title": "Proportion of Habitat Lost (%)",
          "scale": {
            "domain": [0, 14]
          },
          "axis": {
            "format": ".1f",
            "grid": true,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 3
          },
          "encoding": {
            "color": {
              "value": "#c2571a"
            },
            "tooltip": [
              {
                "field": "Species",
                "type": "nominal",
                "title": "Species"
              },
              {
                "field": "Proportion_Lost",
                "type": "quantitative",
                "title": "Proportion Lost (%)",
                "format": ".2f"
              },
              {
                "field": "Area_Lost_Millions",
                "type": "quantitative",
                "title": "Area Lost (M ha)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "description": "Numeric Label on Southern black-throated finch tip",
          "transform": [
            {
              "filter": "datum.Species === 'Southern black-throated finch'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 6,
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#c2571a",
            "text": "10.0%"
          }
        },
        {
          "description": "Annotation for Finch habitat destruction context",
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10.5,
            "fill": "#9a3412"
          },
          "encoding": {
            "x": {
              "datum": 6.2
            },
            "y": {
              "datum": "Ghost bat"
            },
            "text": {
              "value": [
                "Grazing & coal mining cleared",
                "10.0% of the Finch's entire",
                "potential habitat in Queensland."
              ]
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
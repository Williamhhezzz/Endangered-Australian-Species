{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Land Clearing: Total Habitat Area Lost vs. Proportion of Habitat Destroyed",
    "font": "Inter, sans-serif",
    "fontSize": 15,
    "fontWeight": "bold",
    "color": "#0f172a",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "padding": {"left": 15, "right": 15, "top": 10, "bottom": 10},
  "data": {
    "url": "data/c8_habitat_loss.csv"
  },
  "transform": [
    {
      "calculate": "datum.Species === 'Bluegrass' ? 'Bluegrass (native plant)' : datum.Species",
      "as": "Species_Clean"
    }
  ],
  "spacing": 20,
  "hconcat": [
    {
      "title": null,
      "width": 320,
      "height": 340,
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": [
            "Red goshawk",
            "Ghost bat",
            "Star finch",
            "Northern quoll",
            "Bluegrass",
            "Painted honeyeater",
            "Squatter pigeon",
            "Malleefowl",
            "Koala",
            "Southern black-throated finch"
          ],
          "axis": {
            "labelFontSize": 12,
            "labelFontWeight": "normal",
            "labelColor": "#0f172a",
            "labelLimit": 260,
            "labelExpr": "datum.value === 'Bluegrass' ? 'Bluegrass (native plant)' : datum.value"
          }
        },
        "x": {
          "field": "Area_Lost_Millions",
          "type": "quantitative",
          "title": "Area Lost (Million Hectares)",
          "scale": {
            "reverse": true,
            "domain": [0, 4.0]
          },
          "axis": {
            "format": ".1f",
            "grid": true,
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 3
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.Species === 'Red goshawk'",
                "value": "#0f172a"
              },
              "value": "#94a3b8"
            },
            "tooltip": [
              {
                "field": "Species_Clean",
                "type": "nominal",
                "title": "Species"
              },
              {
                "field": "Area_Lost_Millions",
                "type": "quantitative",
                "title": "Area Lost (Million Hectares)",
                "format": ".2f"
              },
              {
                "field": "Proportion_Lost",
                "type": "quantitative",
                "title": "Proportion of Habitat Destroyed (%)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "description": "Numeric Labels on extreme species tips",
          "transform": [
            {
              "filter": "datum.Species === 'Red goshawk' || datum.Species === 'Southern black-throated finch'"
            },
            {
              "calculate": "datum.Species === 'Red goshawk' ? '3.02M' : '0.70M'",
              "as": "label_val"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -6,
            "fontSize": 10,
            "fontWeight": "bold"
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.Species === 'Red goshawk'",
                "value": "#0f172a"
              },
              "value": "#475569"
            },
            "text": {
              "field": "label_val",
              "type": "nominal"
            }
          }
        },
        {
          "description": "Annotation for Red Goshawk habitat context",
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 9.5,
            "fill": "#334155"
          },
          "encoding": {
            "x": {
              "datum": 3.8
            },
            "y": {
              "datum": "Koala"
            },
            "text": {
              "value": [
                "Red Goshawk lost 3.02M ha,",
                "but that is only 2.3% of its",
                "vast continental range."
              ]
            }
          }
        }
      ]
    },
    {
      "title": null,
      "width": 320,
      "height": 340,
      "encoding": {
        "y": {
          "field": "Species",
          "type": "nominal",
          "title": null,
          "sort": [
            "Red goshawk",
            "Ghost bat",
            "Star finch",
            "Northern quoll",
            "Bluegrass",
            "Painted honeyeater",
            "Squatter pigeon",
            "Malleefowl",
            "Koala",
            "Southern black-throated finch"
          ],
          "axis": null
        },
        "x": {
          "field": "Proportion_Lost",
          "type": "quantitative",
          "title": "Proportion of Habitat Lost (%)",
          "scale": {
            "domain": [0, 14]
          },
          "axis": {
            "format": ".1f",
            "values": [0, 2, 4, 6, 8, 10, 12, 14],
            "grid": true,
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 3
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.Species === 'Southern black-throated finch'",
                "value": "#0f172a"
              },
              "value": "#94a3b8"
            },
            "tooltip": [
              {
                "field": "Species_Clean",
                "type": "nominal",
                "title": "Species"
              },
              {
                "field": "Proportion_Lost",
                "type": "quantitative",
                "title": "Proportion of Habitat Destroyed (%)",
                "format": ".2f"
              },
              {
                "field": "Area_Lost_Millions",
                "type": "quantitative",
                "title": "Area Lost (Million Hectares)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "description": "Numeric Labels on extreme species tips",
          "transform": [
            {
              "filter": "datum.Species === 'Red goshawk' || datum.Species === 'Southern black-throated finch'"
            },
            {
              "calculate": "datum.Species === 'Southern black-throated finch' ? '10.0%' : '2.3%'",
              "as": "label_val"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 6,
            "fontSize": 11.5,
            "fontWeight": "bold"
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.Species === 'Southern black-throated finch'",
                "value": "#0f172a"
              },
              "value": "#475569"
            },
            "text": {
              "field": "label_val",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#0f172a"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 12,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
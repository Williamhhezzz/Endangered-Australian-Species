{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "title": {
    "text": "Threatened Mammal Abundance Trends by Conservation Management",
    "subtitle": "Relative population index (2000 baseline = 1.0).",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/c9_mammal_management.csv"
  },
  "layer": [
    {
      "description": "Baseline Reference Line at Index = 1.0",
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "#94a3b8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "datum": 1.0
        }
      }
    },
    {
      "description": "Trend Lines",
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d",
            "grid": false,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "Index",
          "type": "quantitative",
          "title": "Relative Abundance Index (2000 = 1.0)",
          "scale": {
            "type": "linear",
            "zero": true
          },
          "axis": {
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "field": "Management",
          "type": "nominal",
          "title": "Management Status",
          "scale": {
            "domain": [
              "Predator-Free Havens",
              "Any Known Management",
              "No Known Management"
            ],
            "range": [
              "#A4006D",
              "#A8A7FC",
              "#f2e41d"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolSize": 120
          }
        }
      }
    },
    {
      "description": "Data Points with Tooltip",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 45
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative"
        },
        "y": {
          "field": "Index",
          "type": "quantitative"
        },
        "color": {
          "field": "Management",
          "type": "nominal",
          "scale": {
            "domain": [
              "Predator-Free Havens",
              "Any Known Management",
              "No Known Management"
            ],
            "range": [
              "#A4006D",
              "#A8A7FC",
              "#f2e41d"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Management",
            "type": "nominal",
            "title": "Management Tier"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "Index",
            "type": "quantitative",
            "title": "Index Value",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
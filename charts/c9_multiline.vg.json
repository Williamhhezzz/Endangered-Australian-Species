{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "title": {
    "text": "Threatened Mammal Abundance by Management Status (2000–2017)",
    "subtitle": [
      "Relative population index (2000 baseline = 1.0) comparing fenced sanctuaries,",
      "general management, and unmanaged wild populations."
    ],
    "fontSize": 17,
    "subtitleFontSize": 13,
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/c9_mammal_management.csv"
  },
  "layer": [
    {
      "description": "Baseline Reference Line at Index = 1.0",
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "#94a3b8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "datum": 1.0
        }
      }
    },
    {
      "description": "Trend Lines",
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [2000, 2019.5]
          },
          "axis": {
            "format": "d",
            "values": [2000, 2004, 2008, 2012, 2016],
            "grid": false,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "Index",
          "type": "quantitative",
          "title": "Relative Abundance Index (2000 = 1.0)",
          "scale": {
            "type": "linear",
            "zero": true,
            "domainMax": 9.5
          },
          "axis": {
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "field": "Management",
          "type": "nominal",
          "title": "Management Status",
          "scale": {
            "domain": [
              "Predator-Free Havens",
              "Any Known Management",
              "No Known Management"
            ],
            "range": [
              "#15803d",
              "#6366f1",
              "#334155"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolSize": 120
          }
        }
      }
    },
    {
      "description": "Data Points with Tooltip",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 45
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {
            "domain": [2000, 2019.5]
          }
        },
        "y": {
          "field": "Index",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "zero": true,
            "domainMax": 9.5
          }
        },
        "color": {
          "field": "Management",
          "type": "nominal",
          "scale": {
            "domain": [
              "Predator-Free Havens",
              "Any Known Management",
              "No Known Management"
            ],
            "range": [
              "#15803d",
              "#6366f1",
              "#334155"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Management",
            "type": "nominal",
            "title": "Management Tier"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "Index",
            "type": "quantitative",
            "title": "Index Value",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "description": "Right End Label: Predator-Free Havens",
      "data": {
        "values": [
          {"Year": 2017, "Index": 8.29, "text": "+729% (8.3x)"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#15803d"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Index", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Right End Label: Any Known Management",
      "data": {
        "values": [
          {"Year": 2017, "Index": 1.28, "text": "+28% (1.3x)"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#6366f1"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Index", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Right End Label: No Known Management",
      "data": {
        "values": [
          {"Year": 2017, "Index": 0.41, "text": "-59% (0.4x)"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#334155"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Index", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Callout Annotation for Predator-Free Havens",
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#1f6f5c",
        "text": [
          "Predator-Free Havens (+729%):",
          "Removing feral cats and foxes",
          "triggers rapid population recovery."
        ]
      },
      "encoding": {
        "x": {
          "datum": 2005
        },
        "y": {
          "datum": 6.8
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
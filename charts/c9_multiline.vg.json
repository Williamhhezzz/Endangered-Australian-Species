{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "title": {
    "text": "Threatened Mammal Recovery by Management (2000–2017)",
    "subtitle": [
      "Population index (Year 2000 = 1.0) comparing",
      "fenced sanctuaries, general management, and wild sites."
    ],
    "font": "Inter, sans-serif",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f172a",
    "subtitleFont": "Inter, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#475569",
    "anchor": "start",
    "frame": "bounds",
    "offset": 12
  },
  "data": {
    "url": "data/c9_mammal_management.csv"
  },
  "layer": [
    {
      "description": "Baseline Reference Line at Index = 1.0",
      "mark": {
        "type": "rule",
        "strokeDash": [4, 4],
        "color": "#94a3b8",
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "datum": 1.0
        }
      }
    },
    {
      "description": "Trend Lines",
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [2000, 2019.5]
          },
          "axis": {
            "format": "d",
            "values": [2000, 2004, 2008, 2012, 2016],
            "grid": false,
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "Index",
          "type": "quantitative",
          "title": "Population Index (Year 2000 = 1.0)",
          "scale": {
            "type": "linear",
            "zero": true,
            "domainMax": 9.5
          },
          "axis": {
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "color": {
          "field": "Management",
          "type": "nominal",
          "title": "Management Status",
          "scale": {
            "domain": [
              "Predator-Free Havens",
              "Any Known Management",
              "No Known Management"
            ],
            "range": [
              "#0284c7",
              "#64748b",
              "#ea580c"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "labelLimit": 200,
            "symbolSize": 120
          }
        }
      }
    },
    {
      "description": "Data Points with Tooltip",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 45
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {
            "domain": [2000, 2019.5]
          }
        },
        "y": {
          "field": "Index",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "zero": true,
            "domainMax": 9.5
          }
        },
        "color": {
          "field": "Management",
          "type": "nominal",
          "scale": {
            "domain": [
              "Predator-Free Havens",
              "Any Known Management",
              "No Known Management"
            ],
            "range": [
              "#0284c7",
              "#64748b",
              "#ea580c"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Management",
            "type": "nominal",
            "title": "Management Tier"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "Index",
            "type": "quantitative",
            "title": "Index Value",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "description": "Right End Label: Predator-Free Havens",
      "data": {
        "values": [
          {"Year": 2017, "Index": 8.29, "text": "+729%"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#0284c7"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Index", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Right End Label: Any Known Management",
      "data": {
        "values": [
          {"Year": 2017, "Index": 1.28, "text": "+28%"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#64748b"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Index", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Right End Label: No Known Management",
      "data": {
        "values": [
          {"Year": 2017, "Index": 0.41, "text": "-59%"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#ea580c"
      },
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "Index", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"}
      }
    },
    {
      "description": "Callout Annotation for Predator-Free Havens",
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "fill": "#0284c7",
        "text": [
          "Predator-Free Havens:",
          "8.3x baseline by 2017 (vs. 0.4x unmanaged)"
        ]
      },
      "encoding": {
        "x": {
          "datum": 2000.5
        },
        "y": {
          "datum": 7.8
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 18,
      "fontWeight": "bold",
      "color": "#0f172a",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#475569"
    },
    "axis": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#334155",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#475569"
    },
    "legend": {
      "titleFont": "Inter, sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1e293b",
      "labelFont": "Inter, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#334155"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}